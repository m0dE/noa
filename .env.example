# All optional: the extension builds and its tests pass without any of these.
# Copy to .env and fill in what you need. Never commit .env.

# Build: the Google OAuth client ID Log In uses (else it asks the account server for one).
# Set it in the shell for `pnpm build`, or see apps/extension/README.md.
NOA_GOOGLE_CLIENT_ID=

# Live tests (apps/extension/test/manual, run with NOA_LIVE=1). They call real APIs and cost money.
# Claude:
ANTHROPIC_API_KEY=
# Jev:
TYPESAFE_API_KEY=
# OpenAI Realtime voice:
OPENAI_API_KEY=
