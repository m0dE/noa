{
  "manifest_version": 3,
  "name": "Noa",
  "version": "0.2.0",
  "description": "Works through your todo list in this Chrome with an AI agent: Claude (API or local Claude Code), optionally sped up by Jev.",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "alarms",
    "storage",
    "notifications",
    "tts",
    "offscreen",
    "tabs",
    "sidePanel",
    "downloads",
    "downloads.ui",
    "unlimitedStorage",
    "tabGroups",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Noa",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
      "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "commands": {
    "open-chat": {
      "suggested_key": {
        "default": "Ctrl+Period",
        "mac": "Command+Period"
      },
      "description": "Open Noa in the side panel and focus the chat input"
    },
    "voice": {
      "suggested_key": {
        "default": "Ctrl+Comma",
        "mac": "MacCtrl+Comma"
      },
      "description": "Talk to Noa hands-free in the side panel; press again to stop"
    }
  }
}
